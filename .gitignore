# ============================================================
# Claude Code — personal / local-only files
# (commit the shared ones: CLAUDE.md, .claude/settings.json,
#  .claude/commands/, .claude/agents/, .claude/skills/, .mcp.json)
# ============================================================
 
# Personal settings overrides (permissions, env, model choices)
.claude/settings.local.json
 
# Personal memory / instructions not meant for the team
CLAUDE.local.md
 
# Git worktrees created by Claude Code sessions
.claude/worktrees/
 
# Scratch / session state / transcripts that may appear in the project
.claude/scratch/
.claude/tmp/
.claude/logs/
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
