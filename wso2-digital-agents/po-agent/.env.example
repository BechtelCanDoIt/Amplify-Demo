# Server
PORT=3000

# Log verbosity. Set to "debug" to include raw backend response bodies in error logs
# (only the sanitized status + extracted message are logged otherwise). Backend bodies
# can carry stack traces, SQL fragments, employee records, or OAuth-provider blobs —
# leave unset / "info" in production unless actively debugging.
LOG_LEVEL=info

# Trust the first reverse proxy's X-Forwarded-For header.
# Set to true when deploying behind a trusted reverse proxy (e.g. Choreo ingress, nginx,
# AWS ALB) so rate limiting and IP-based logging use the real client IP from the
# X-Forwarded-For header instead of the proxy's IP.
# Set to false (or omit) for direct-exposure deployments — otherwise an attacker can
# spoof X-Forwarded-For to bypass IP-based rate limits and pollute IP-keyed audit logs.
# Must be true on Choreo.
TRUST_PROXY=true

# Token encryption key — AES-256-GCM key for encrypting OAuth tokens at rest in MySQL.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# URL of the Google Form the PO Team uses to receive letter requests
# (employment confirmation, visa letter, salary letters, passport renewal, etc.).
# Set per-environment — staging and prod typically use different form URLs.
LETTER_REQUEST_FORM_URL=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — override the Anthropic API endpoint. Leave unset to call the public
# API (https://api.anthropic.com). Set it to route through a proxy, an internal
# gateway, or a mock server in local dev / tests.
# The API key above is sent to whatever host is configured here, so point it only
# at a host you control and keep it https outside localhost. A value that isn't a
# parseable URL fails fast at startup; the effective endpoint is logged on boot.
# ANTHROPIC_BASE_URL=

# Per-user LLM token quota (input + output, summed across all agentic rounds)
# in a rolling 24-hour window. When a user exceeds this, the bot rejects new
# chat turns with a polite "try again later" reply, emits a [quota] log line,
# and audit-logs a BLOCKED row (action=llm_quota). Default 50_000 ≈ ~$0.50/user/day
# at Sonnet 4.6 pricing if no prompt-cache hits — covers normal usage; abusive
# or runaway loops stop before they accumulate real spend. Lower to throttle
# harder, raise if legitimate heavy users routinely hit the cap (check the
# top-consumers query in RUNBOOK to inform the new value).
USER_TOKEN_QUOTA_PER_DAY=50000

# Delay (ms) before the async-reply flow posts the "⏳ Working on it..."
# placeholder. Chat turns that finish under this threshold skip the
# placeholder entirely (one Chat API call instead of two — cleaner UX, half
# the API volume on fast paths). Slower turns still get the placeholder.
# Default 3000 — drop to 1500–2000 if users notice a silent gap, raise to
# 5000+ to suppress the placeholder on more turns.
PLACEHOLDER_DELAY_MS=3000

# Asgardeo OAuth2 — for user authentication (on-demand OAuth flow)
# Scopes must include: openid email groups
# (groups scope is required so the id_token carries role claims for OPD backend checks)
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=
ASGARDEO_AUTH_ENDPOINT=https://<org>.asgardeo.io/oauth2/authorize
ASGARDEO_TOKEN_ENDPOINT=https://<org>.asgardeo.io/oauth2/token
ASGARDEO_REDIRECT_URI=https://<your-proxy-url>/auth/callback

# MySQL (po_agent database)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=po_agent
DB_SSL=true

# DigiOps Backend Services (Choreo API Gateway URLs — from Developer Portal)
LEAVE_BACKEND_URL=https://<choreo-gateway-url>/leave-app/v1
MENU_BACKEND_URL=https://<choreo-gateway-url>/menu-app/v1
# people-app backend — used for vehicle add/list/delete tools
PEOPLE_BACKEND_URL=https://<choreo-gateway-url>/people-app/v1

# gh-project-board-stats backend — answers "what's releasing this/next week"
# questions from the WSO2 engineering project board. Source: the
# gh-project-board-stats service in engineering-tools deployed on Choreo.
# The service holds its own GitHub credentials; Novera just authenticates
# via the same Choreo gateway flow (x-jwt-assertion) as the other backends.
# Get the gateway URL from the Choreo Developer Portal.
RELEASES_BACKEND_URL=https://<choreo-gateway-url>/gh-project-board-stats/v1

# subscription-app backend — lunch (meal) subscribe/unsubscribe and commute
# (PickMe) subscribe/unsubscribe tools.
SUBSCRIPTION_BACKEND_URL=https://<choreo-gateway-url>/subscription-app-backend/v1.0

# Choreo Token Exchange (RFC 8693)
# The user's Asgardeo idToken is exchanged for a Choreo-scoped token using these
# credentials. This token is accepted by the Choreo API Gateway for subscribed APIs
# and carries the user's email + groups claims (identity + roles preserved).
# Obtain from: Choreo Developer Portal → Applications → digiops-agent → OAuth2 Keys
CHOREO_TOKEN_ENDPOINT=https://sts.choreo.dev/oauth2/token
CHOREO_CLIENT_ID=
CHOREO_CLIENT_SECRET=

# Google Chat — the full public URL of this webhook endpoint
# Used to verify the JWT audience in incoming webhook requests
# e.g. https://your-proxy-url/webhook
GOOGLE_CHAT_WEBHOOK_AUDIENCE=

# Google Chat — exact service-account email Google uses to sign incoming webhook JWTs.
# Pinning to this caller closes the gap where a different SA in the same
# gcp-sa-gsuiteaddons.iam.gserviceaccount.com domain could be accepted.
# Format: service-<your-project-number>@gcp-sa-gsuiteaddons.iam.gserviceaccount.com
# See docs/google-setup.md → "Capturing the inbound webhook caller email" for how to obtain.
GOOGLE_CHAT_WEBHOOK_CALLER_EMAIL=

# Google Chat — service account credentials (JSON) for sending proactive messages
# after OAuth completion. Paste the entire contents of the downloaded JSON key file.
# The service account must belong to the same Cloud project as the Workspace Add-on.
GOOGLE_SERVICE_ACCOUNT_KEY=

# HR policy Drive folder — the agent syncs all supported docs (Google Docs, plain text)
# in this folder into its system prompt for policy Q&A. The folder ID is the segment
# after /folders/ in the Drive URL. Share the folder with the wso2.com user whose
# OAuth refresh token is configured below (normal wso2.com Drive sharing — no admin
# involvement). See docs/google-setup.md → "HR policy Drive ingestion".
HR_POLICY_DRIVE_FOLDER_ID=

# Master switch for the HR-policy Drive sync. Set to false to skip the startup
# and recurring sync entirely — the agent still runs, but HR policy Q&A will
# answer "policy lookup not currently available" until enabled. Useful for
# local dev, debugging, or environments where the policy folder isn't set up
# yet. Other features (leave, menu, vehicles, issues) are unaffected.
HR_POLICY_SYNC_ENABLED=true

# Optional — how often to re-pull policy docs from Drive. Default 24 hours.
HR_POLICY_SYNC_INTERVAL_HOURS=24

# OAuth 2.0 credentials for reading the HR policy Drive folder.
# Service accounts don't work — WSO2 Workspace policy blocks Drive sharing with
# `*.iam.gserviceaccount.com` addresses. Instead, a real wso2.com user authorizes
# the bot once via Google's OAuth consent flow and the resulting refresh token is
# stored here. See docs/google-setup.md → "HR policy Drive ingestion" for the
# one-time setup (creating the OAuth client + obtaining the refresh token).
HR_POLICY_GOOGLE_OAUTH_CLIENT_ID=
HR_POLICY_GOOGLE_OAUTH_CLIENT_SECRET=
HR_POLICY_GOOGLE_OAUTH_REFRESH_TOKEN=

# Google Sheet ID for user-reported issue tracking. The same OAuth refresh token
# above must include both `drive.readonly` AND `spreadsheets` scopes — see
# docs/google-setup.md → "Issues sheet" for the scope-upgrade procedure if
# you're enabling this feature on top of an existing drive-only token.
ISSUES_SHEET_ID=

# ── WSO2 Training & Certification corpus (v1.1.0) ───────────────────────────
# Novera injects a training/certification playbook into its system prompt,
# similar to HR policy. The playbook is a Google Doc owned and edited by the
# Training & Certification team; Novera syncs it on the configured cadence.

# Master switch for the training corpus sync. When false, Novera falls back
# to a short "training playbook not currently available" note in its system
# prompt and points users to the escalation contacts below. Useful for local
# dev, staging bootstrap before the Drive folder is set up, or if the training
# team needs the corpus temporarily withdrawn.
TRAINING_SYNC_ENABLED=true

# Google Drive folder ID for the training playbook. Owned by the Training &
# Certification team; share with the same wso2.com user whose OAuth refresh
# token drives HR-policy sync (one OAuth identity, two Drive folders).
# Only required when TRAINING_SYNC_ENABLED=true.
TRAINING_DRIVE_FOLDER_ID=

# Sync cadence — default 24h. The playbook changes slowly (link updates,
# occasional new certification pages), so 24h is comfortable.
TRAINING_SYNC_INTERVAL_HOURS=24

# Escalation contacts injected into the system prompt as authoritative
# "current" addresses. The model prefers these over any older addresses that
# may appear in the playbook body. Required — the app fails fast at startup
# if any of these are missing. Keeps personal email addresses out of source
# control and lets ops rotate them per environment without a code change.
TRAINING_TEAM_EMAIL=
CERTIFICATION_TEAM_EMAIL=
# Comma-separated free-form string of team leads. Injected verbatim.
TRAINING_TEAM_LEADS=

# ── Cafeteria menu cache ───────────────────────────────────────────────────
# Opportunistic on-demand cache — the first Sri Lanka user asking about the
# menu triggers a get_menu tool call (authenticated with their id_token), and
# the result is UPSERTed into agent_menu_cache. Subsequent turns inject the
# cached menu into the system prompt so the model answers without a tool
# round-trip. Cache also invalidates when the stored date != today (Colombo
# TZ), so day-boundary correctness holds even if TTL is longer than a day.
# Default 1h — menu changes at most daily; a short TTL surfaces backend
# updates quickly with negligible extra tool calls.
MENU_CACHE_TTL_HOURS=1
