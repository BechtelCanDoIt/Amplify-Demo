// Template for public/config.js — copy to public/config.js and fill values.
// This file is loaded at runtime by index.html BEFORE the React bundle, so
// every environment can serve the same static bundle with different config.
// Never commit the filled-in config.js (see .gitignore).
//
// Every backend URL below is optional. When one is absent, that feature shows
// a "not connected" notice naming the key and makes no requests.
window.config = {
  // Asgardeo OAuth
  ONE_WSO2_AUTH_BASE_URL: "https://api.asgardeo.io/t/<your-org>",
  ONE_WSO2_AUTH_CLIENT_ID: "<your-client-id>",
  ONE_WSO2_AUTH_SIGN_IN_REDIRECT_URL: "http://localhost:3000",
  ONE_WSO2_AUTH_SIGN_OUT_REDIRECT_URL: "http://localhost:3000",
  // Optional override — only needed for non-standard Asgardeo deployments.
  // Defaults to the ONE_WSO2_AUTH_BASE_URL with the api. subdomain swapped
  // for myaccount. (Asgardeo Cloud convention).
  // ONE_WSO2_ASGARDEO_MYACCOUNT_URL: "https://myaccount.asgardeo.io/t/<your-org>",

  // Optional — only for identity servers that don't follow Asgardeo's URL
  // layout, such as ThunderID. Points the SDK at the server's OIDC discovery
  // document so the issuer and logout endpoint match what the server uses.
  // Setting it signs in through ThunderProvider instead of the stock AsgardeoProvider.
  // ONE_WSO2_AUTH_WELL_KNOWN_URL: "https://<idp-host>/.well-known/openid-configuration",

  // UI
  ONE_WSO2_THEME: "wso2",

  // People backend base URL. Powers the Me profile, My Team, Org Chart and the
  // People Ops reports.
  ONE_WSO2_PEOPLE_BACKEND_URL: "<your-people-backend-url>",

  // Cafeteria menu backend (daily menu, lunch feedback, dinner orders).
  // ONE_WSO2_MENU_BACKEND_URL: "<your-menu-backend-url>",

  // Today I Learned backend — the Knowledge perspective's learnings
  // feed.
  // ONE_WSO2_TIL_BACKEND_URL: "<your-til-backend-url>",

  // Amplify API proxy — the Amplify app (Celebrate, New Post, Current Posts).
  // Shown only while `amplify` is on in ONE_WSO2_PREVIEW_FEATURES below.
  // ONE_WSO2_AMPLIFY_BACKEND_URL: "<your-amplify-api-proxy-url>",
  // WSO2's LinkedIn organization URN, sent as the owner of every new post.
  // ONE_WSO2_AMPLIFY_LINKEDIN_ORG_URN: "urn:li:organization:<id>",
  // Where post links and the LinkedIn sign-in may point. Default: LinkedIn only. Dev/demos with the mock:
  // ONE_WSO2_AMPLIFY_POST_LINK_ORIGINS: ["https://www.linkedin.com", "https://linkedin.com", "http://localhost:19091"],

  // Subscriptions backend (PickMe Commute + LaaS opt-in/opt-out). The two
  // admin group names come from this backend's own /subscriptions/meta-info,
  // so there is no separate config key for them.
  // ONE_WSO2_SUBSCRIPTION_BACKEND_URL: "<your-subscription-backend-url>",

  // Email groups backend (Google Groups subscriptions).
  // ONE_WSO2_EMAIL_GROUPS_BACKEND_URL: "<your-email-groups-backend-url>",
  // MEDDPICC backend (digiops-sales echo-backend). Powers the Deals tab and the
  // MEDDPICC column on Sales -> Meetings. When unset, Deals shows that it is not
  // connected and Meetings leaves the MEDDPICC column out.
  // ONE_WSO2_ECHO_BACKEND_URL: "https://apis-stg.wso2.com/<component>/echo-backend/v1.0",

  // Sales meetings backend — powers the Sales perspective's meeting history.
  // Leaving it unset does NOT hide Sales: the perspective is registered
  // regardless, and /sales renders its own "not connected" notice, which is
  // how an operator finds out the key is missing. Recording playback URLs
  // arrive from this backend fully formed; nothing here constructs them.
  // ONE_WSO2_REVOPS_BACKEND_URL: "<your-sales-meetings-backend-url>",

  // CadO2 quote tool backend — powers Sales → CadO2 (quotes, approvals and
  // their admin). Shown only while `cado2` is on in ONE_WSO2_PREVIEW_FEATURES
  // below. With the flag on and this unset, CadO2's pages say "not connected"
  // and make no requests. Salesforce record links use
  // ONE_WSO2_SALESFORCE_BASE_URL.
  // ONE_WSO2_CADO2_BACKEND_URL: "<your-cado2-backend-url>",

  // Pitstop backend that serves Smart Search — powers Sales → Library, the
  // plain-language search over Pitstop's content. Include the version segment.
  // Shown only while `smartSearch` is on in ONE_WSO2_PREVIEW_FEATURES below.
  // With the flag on and this unset, the page says "not connected" and makes
  // no requests.
  // ONE_WSO2_SMART_SEARCH_BACKEND_URL: "<your-pitstop-backend-url>",

  // Promotion backend. Requests carry the x-user-timezone-offset header.
  // Also powers the Me page's "Last promotion" row.
  // ONE_WSO2_PROMOTION_BACKEND_URL: "<your-promotion-backend-url>",

  // PAR backend. Requests carry the x-user-timezone-offset header. Also
  // powers the Me page's active-review row.
  // ONE_WSO2_PAR_BACKEND_URL: "<your-par-backend-url>",
  // OAuth client ID for the Lead Portal's "Attach from Google Drive" evidence
  // picker (scope: drive.readonly). When absent, the picker's token request
  // fails.
  // ONE_WSO2_PAR_GOOGLE_OAUTH_CLIENT_ID: "<your-google-oauth-client-id>",
  // Browser API key for the same picker. Usually not needed; set it only if
  // Google reports an invalid developer key. Restrict it by HTTP referrer.
  // ONE_WSO2_PAR_GOOGLE_PICKER_API_KEY: "<your-google-picker-api-key>",
  // The PAR rating names that trigger the Top 5%/20% checkbox and the evidence
  // requirement. Configurable because admins can rename the rating list.
  // ONE_WSO2_PAR_TOP5P20P_ENABLED_RATING: "Successful",
  // ONE_WSO2_PAR_EVIDENCE_ENABLED_RATING: "Needs Improvement",

  // Banking backend (the Me → Banking page and the Bank accounts card). Unlike
  // the PAR and Promotion backends, it does NOT take the
  // x-user-timezone-offset header.
  // ONE_WSO2_BANKING_BACKEND_URL: "<your-banking-backend-url>",

  // Leave backend (Me → Leave: apply, history, approvals, reports). It has its
  // own /user-info and privileges.
  // ONE_WSO2_LEAVE_BACKEND_URL: "<your-leave-backend-url>",

  // Leave web app base URL (not its backend) — a deep-link target for flows
  // this app doesn't offer. When absent, that link is hidden.
  // ONE_WSO2_LEAVE_WEB_APP_URL: "<your-leave-web-app-url>",

  // GRC platform backend — Risk Hub, Audit Hub and Admin Console in the
  // Security and Compliance perspective. That backend must list this app's
  // Asgardeo client id in its AUTH_AUDIENCE, or every request from here 401s.
  // See src/config/apiConfig.ts.
  // ONE_WSO2_GRC_PLATFORM_BACKEND_URL: "<your-grc-platform-backend-url>",

  // Evidence Portal backend — the third app in Security and Compliance, a
  // separate service from the GRC platform, with the same audience
  // requirement.
  // ONE_WSO2_EVIDENCE_PORTAL_BACKEND_URL: "<your-evidence-portal-backend-url>",

  // Finance backends — OPD claims, credit card expenses, expense claims and
  // master data. Each has its own /user-info and role scheme.
  // ONE_WSO2_OPD_BACKEND_URL: "<your-opd-claims-backend-url>",
  // ONE_WSO2_CC_EXPENSES_BACKEND_URL: "<your-cc-expenses-backend-url>",
  // ONE_WSO2_EXPENSE_CLAIMS_BACKEND_URL: "<your-expense-claims-backend-url>",
  // ONE_WSO2_FINANCE_MASTER_DATA_BACKEND_URL: "<your-finance-master-data-backend-url>",

  // Updates Manager backend. The value is the service root; the access check
  // is GET <base-url>/update/user-info.
  // ONE_WSO2_UMT_BACKEND_URL: "<your-updates-manager-backend-url>",

  // Finance MIS — the ARR service at ONE_WSO2_MIS_ARR_BACKEND_URL. Optional —
  // when absent, MIS makes no requests.
  //
  // Two things to get right, each of which fails silently if you don't:
  //
  //  1. Prefer the *.wso2.com gateway URL over the *.choreoapis.dev one
  //     Choreo advertises next to it. The production CSP allows both, so
  //     either works; the wso2.com one is the stable vanity URL.
  //  2. The version segment is part of the URL and differs by environment —
  //     production ends /v1, staging ends /v1.0. Don't normalise them.
  //
  // Only ONE_WSO2_MIS_ARR_BACKEND_URL is configured. This app does not call
  // any other MIS service, so there is no key for one.
  //
  // Who sees Finance MIS is the ARR privilege from this service's /user-info.
  // ARR Analysis also stays hidden until this service turns that screen on.
  //
  // ONE_WSO2_MIS_ARR_BACKEND_URL: "<mis-arr-backend-url>",

  // Marketing Ops backend. Its routes live under /api/*, and the gateway
  // preserves that prefix.
  // ONE_WSO2_MARKETINGOPS_BACKEND_URL: "<your-marketing-ops-backend-url>",

  // digiops-marketing agenda-organizer backend base URL — the Event Platform
  // screens under Marketing Ops. A service of its own, not part of the
  // marketing-ops backend above. That backend's /api/me decides what the UI
  // shows; this one enforces its own roles on every route. Routes live under
  // /api/*. Optional — when absent, the Event Platform screens show a "not
  // connected" state.
  // ONE_WSO2_EVENT_PLATFORM_BACKEND_URL: "<your-event-platform-backend-url>",

  // Due Diligence backend, surfaced under both the Finance and Legal
  // perspectives.
  // ONE_WSO2_DUE_DILIGENCE_BACKEND_URL: "<your-due-diligence-backend-url>",

  // ISAC base URL — a separate marketing application, linked from the top of
  // the Marketing Ops rail and opened in a new tab. Nothing here calls it as
  // an API. When absent, the rail item is omitted entirely.
  // ONE_WSO2_MARKETINGOPS_ISAC_URL: "<your-isac-url>",

  // CSM base URL — a separate application, reached from its launcher tile and
  // opened in a new tab. There is no route for it, so it is never a landing
  // choice or a favourite. When absent, the tile stays in its unbuilt state.
  // ONE_WSO2_CSM_URL: "<your-csm-url>",

  // Infra Portal backend. Privileges come from this backend's own /user-info
  // (987 employee / 762 approver / 123 admin), not from the People backend.
  // ONE_WSO2_INFRA_BACKEND_URL: "<your-infra-portal-backend-url>",

  // Base URL of the Product Download Stats API, including the version segment.
  // Optional — when absent, Engineering Overview says it isn't connected and
  // makes no requests.
  // ONE_WSO2_PRODUCT_DOWNLOAD_STATS_BACKEND_URL: "<product-download-stats-backend-url>",

  // Pardot UI base URL — for deep-linking to an email template after Email
  // Workbench pushes it. A link target, not an API. Defaults to
  // https://pi.pardot.com.
  // ONE_WSO2_PARDOT_BASE_URL: "https://pi.pardot.com",

  // GitHub OAuth for Infra Portal connect. Authorize URL defaults to GitHub.
  // Redirect URL must be this app's origin + /infra/github/callback, and that
  // exact URL must be registered on the GitHub OAuth app.
  // ONE_WSO2_GITHUB_OAUTH_CLIENT_ID: "<github-oauth-client-id>",
  // ONE_WSO2_GITHUB_OAUTH_AUTHORIZE_URL: "https://github.com/login/oauth/authorize",
  // ONE_WSO2_GITHUB_OAUTH_REDIRECT_URL: "https://<one-wso2-origin>/infra/github/callback",

  // Salesforce Lightning base URL — for deep-linking to the record an incoming
  // one collided with, from CRM Upload's review queue. A link target, not an
  // API. Defaults to https://wso2.lightning.force.com. Set it only for a
  // sandbox org.
  // ONE_WSO2_SALESFORCE_BASE_URL: "https://wso2.lightning.force.com",

  // Idle handling. Defaults to false. The "Are you still there?" dialog
  // appears after 25 minutes of inactivity either way; this decides only what
  // happens if it is ignored. False leaves it waiting and the session alive;
  // true signs out at 30 minutes.
  // ONE_WSO2_IDLE_AUTO_SIGN_OUT: false,

  // Features that are built and merged but not released yet. Absent or false
  // hides the feature — a deployment that says nothing shows nothing, so
  // production is safe without anyone remembering to add an entry.
  //
  // NOT the same as an empty backend URL above. That means "not wired up";
  // this means "wired up, but not for you yet".
  //
  // Each entry is deleted when its feature ships — a list that only grows
  // stops describing anything.
  //
  // ONE_WSO2_PREVIEW_FEATURES: { umt: false, infra: false, cado2: false, nda: false, smartSearch: false, amplify: false },

};
